# User-specific configuration and generated profile
config.json
profile.json

# Local credentials and machine-specific environment files
.env
.env.*
!.env.example
.npmrc
.codex/
*.pem
*.key
*.p12

# Dependencies and packaged builds
node_modules/
app/node_modules/
desktop/node_modules/
desktop/dist/

# OS and editor files
.DS_Store

# Local Claude settings/auth; retain the distributable setup command
.claude/*
!.claude/commands/

# Private runtime state
/tasks/
/ledger/
/snapshots/
/transcripts/
/memory/
/abstracts/
/decisions/
/categories.json
/jobhist.json
/runs/
/.kaimon-daemon.json
/plan/
/.cache/

# Private app design notes
/app/docs/private/
/app/docs/*diagnosis.txt

# Early local board/mockup files contain personal labels and project names
/dashboard_hybrid.html
/dashboard_templates.html
/mockups/

# R session artifacts
.Rhistory
.RData
.Rproj.user/

# Local research and generated evidence are not application source.
# Keep maintained Markdown docs and regression test/fixture source in Git;
# app/scripts/check-boundary.mjs also rejects these paths in the Git index.
**/.local/
**/.artifacts/
**/research/
**/experiments/
**/renders/
**/mockups/
**/*-mockups/
**/test-results/
**/playwright-report/
**/coverage/
**/screenshots/
/app/docs/**/*.html
/app/docs/language-support/
/app/docs/token-efficiency-review/
/desktop/BLUEPRINT.html
/desktop/BLUEPRINT_AUDIT.txt
/desktop/logo-concepts.html
*.log
